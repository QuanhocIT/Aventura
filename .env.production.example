# ─────────────────────────────────────────────────────────────────────────────
# AVENTURA — MẪU .env CHO PRODUCTION
# Copy sang .env rồi điền giá trị THẬT. KHÔNG commit file .env.
# Xem quy trình đầy đủ: docs/setup/production-deploy.md
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=Aventura
APP_ENV=production
# Sinh mới nếu deploy sạch: `php artisan key:generate`.
# ⚠️ NẾU migrate DB đã có dữ liệu mã hóa (citizen_id, manager_bypass_code...) sang
# server mới thì PHẢI DÙNG LẠI ĐÚNG APP_KEY cũ, nếu không sẽ hỏng dữ liệu giải mã.
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en

# ── LOGGING ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning        # production: warning trở lên; tránh debug lộ thông tin

# ── DATABASE (MySQL 8) ───────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql            # tên service trong docker-compose
DB_PORT=3306
DB_DATABASE=aventura
DB_USERNAME=aventura
DB_PASSWORD=             # đặt mật khẩu mạnh
DB_ROOT_PASSWORD=        # chỉ dùng cho container mysql

# ── SESSION / CACHE / QUEUE (Redis) ──────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true      # BẮT BUỘC true khi chạy HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── MAIL (dùng nhà cung cấp giao dịch, KHÔNG dùng Gmail cá nhân ở production) ──
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# ── REVERB (WebSocket realtime — KDS, thông báo) ─────────────────────────────
# Sinh bộ mới, KHÔNG tái dùng key đã lộ ở môi trường dev.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=your-domain.com     # domain public để client kết nối wss
REVERB_PORT=443
REVERB_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── SCOUT / MEILISEARCH ──────────────────────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=                # đặt master key mạnh
SCOUT_QUEUE=true

# ── GOOGLE OAUTH (xoay secret mới, secret cũ đã lộ) ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ── BILLING / SEPAY (thu tiền tenant) ────────────────────────────────────────
SEPAY_BANK=MBBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_CHECKOUT_URL=https://qr.sepay.vn/img
SEPAY_QR_TEMPLATE=compact
BILLING_WEBHOOK_SECRET=         # sinh mới; cấu hình trùng ở dashboard SePay
BILLING_WEBHOOK_PROVIDER=sepay
BILLING_GRACE_PERIOD_DAYS=30
BILLING_QUEUE=billing

# ── PAYMENT GATEWAY KHÁCH (launch chỉ cần VietQR/bank_transfer qua SePay) ─────
# Để trống = cổng không hiện trên storefront. Điền khi có merchant thật.
VNPAY_TMNCODE=
VNPAY_HASHSECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=

# ── EMAIL MARKETING (Brevo — xoay key mới) ───────────────────────────────────
BREVO_API_KEY=

# ── PUSH / SMS (đổi khỏi 'log' khi có nhà cung cấp thật) ──────────────────────
PUSH_DRIVER=log
SMS_DRIVER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ── BẢO MẬT (Cloudflare Turnstile chống bot cho form công khai) ──────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── ERROR TRACKING (bật để giám sát production) ──────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── BACKUP S3 (Backblaze B2 / Wasabi / AWS S3) ───────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── WAF / RATE LIMIT ─────────────────────────────────────────────────────────
WAF_LOGIN_MAX_ATTEMPTS=5
WAF_LOGIN_DECAY_SECONDS=10
WAF_LOGIN_BLOCK_MINUTES=30
RATE_LIMIT_GLOBAL_MAX=60
RATE_LIMIT_GLOBAL_DECAY=60
