        <mxCell id="r13" value="«extend»" style="endArrow=open;endSize=12;dashed=1;dashPattern=6 6;html=1;rounded=1;strokeWidth=2;strokeColor=#C2410C;fontSize=13;fontStyle=2;fontColor=#C2410C;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.4;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="UC-24" target="UC-08"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="435" y="742"/><mxPoint x="1654" y="742"/></Array></mxGeometry></mxCell>
        <mxCell id="r14" value="«include»" style="endArrow=open;endSize=12;dashed=1;dashPattern=6 6;html=1;rounded=1;strokeWidth=2;strokeColor=#1D4ED8;fontSize=13;fontStyle=2;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="UC-21" target="UC-12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="931" y="766"/></Array></mxGeometry></mxCell>
        <mxCell id="note1" value="&lt;b&gt;UC-23 dùng chung:&lt;/b&gt; mọi gói yêu cầu đăng nhập đều «include» UC-23 (xác thực, 2FA, step-up khi thao tác nhạy cảm). Sơ đồ không vẽ hết 20+ mũi tên này để giữ độ rõ — đúng mục đích của tác nhân trừu tượng A07 nêu ở Ghi chú 1, mục 17.1.2.&lt;br&gt;&lt;br&gt;&lt;b&gt;UC-24 xác thực bằng &lt;i&gt;X-Api-Key&lt;/i&gt;&lt;/b&gt; (không qua session) nên không «include» UC-23." style="shape=note;size=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;strokeColor=#94A3B8;fillColor=#FFFDF5;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1320" y="1044" width="470" height="160" as="geometry"/></mxCell>
        <mxCell id="note2" value="&lt;b&gt;Quy tắc phân loại quan hệ&lt;/b&gt;&lt;br&gt;• «include» — hành vi &lt;b&gt;bắt buộc&lt;/b&gt;, gói cha luôn thực thi gói con.&lt;br&gt;&amp;nbsp;&amp;nbsp;VD: thanh toán luôn trừ kho lõi + ghi nhận doanh thu (mục 10.1 &amp;amp; 10.4).&lt;br&gt;• «extend» — hành vi &lt;b&gt;tùy chọn&lt;/b&gt;, chỉ chạy khi thỏa điều kiện: cờ tính năng của gói cước (&lt;i&gt;QuotaService::hasFeature&lt;/i&gt;) hoặc điều kiện nghiệp vụ.&lt;br&gt;&amp;nbsp;&amp;nbsp;VD: áp voucher &amp;quot;nếu có&amp;quot; (10.4) · giao hàng [&lt;i&gt;qr_ordering&lt;/i&gt;] · AI &amp;amp; phân tích [&lt;i&gt;advanced_analytics, ai_advisor&lt;/i&gt;] · webhook GrabFood/ShopeeFood [&lt;i&gt;api_access&lt;/i&gt;]." style="shape=note;size=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;strokeColor=#94A3B8;fillColor=#FFFDF5;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1810" y="1044" width="536" height="160" as="geometry"/></mxCell>
        <mxCell id="lg" value="CHÚ THÍCH (UML 2.x)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#0F172A;strokeColor=#0F172A;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1500" y="1258" width="846" height="196" as="geometry"/></mxCell>
        <mxCell id="lg_a" value="" style="shape=umlActor;html=1;strokeColor=#0F172A;strokeWidth=2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1524" y="1300" width="26" height="52" as="geometry"/></mxCell>
        <mxCell id="lg_at" value="Tác nhân (Actor)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1562" y="1314" width="190" height="24" as="geometry"/></mxCell>
        <mxCell id="lg_e" value="Gói chức năng&lt;br&gt;(Use Case Package)" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;strokeColor=#0F172A;strokeWidth=2;fillColor=#F1F5F9;" vertex="1" parent="1"><mxGeometry x="1524" y="1364" width="176" height="62" as="geometry"/></mxCell>
        <mxCell id="lg_l1" value="Association — tác nhân tương tác với gói chức năng" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1880" y="1302" width="450" height="22" as="geometry"/></mxCell>
        <mxCell id="lg_l2" value="«include» — bao hàm bắt buộc (cha → con)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1D4ED8;" vertex="1" parent="1"><mxGeometry x="1880" y="1350" width="450" height="22" as="geometry"/></mxCell>
        <mxCell id="lg_l3" value="«extend» — mở rộng tùy chọn (con → cha)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#C2410C;" vertex="1" parent="1"><mxGeometry x="1880" y="1398" width="450" height="22" as="geometry"/></mxCell>
        <mxCell id="lg_d" value="Viền kép/nét chấm = gói có tác nhân đối tác ngoài cùng tham gia (UC-11, UC-18)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1524" y="1430" width="800" height="20" as="geometry"/></mxCell>
