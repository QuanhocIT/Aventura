APP_NAME=Aventura
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Platform administrator bootstrap (never commit the real value)
SUPERADMIN_EMAIL=superadmin@aventura.local
SUPERADMIN_BOOTSTRAP_PASSWORD=
SUPERADMIN_ALLOWED_IPS=
TRUSTED_PROXIES=

# External supplier sign-in and portal (internal supplier operations remain available)
SUPPLIER_PORTAL_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=5

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aventura
DB_USERNAME=root
DB_PASSWORD=

# Read/Write split (config/database.php đã scaffold sẵn read/write host + sticky).
# Để trống = dùng chung 1 instance như DB_HOST hiện tại. Khi có MySQL replica,
# trỏ DB_READ_HOST sang replica để tách luồng đọc báo cáo/analytics khỏi luồng ghi POS.
DB_READ_HOST=
DB_WRITE_HOST=
# Nếu replica dùng credential khác master (thường gặp ở managed DB):
DB_READ_USERNAME=
DB_READ_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2526
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="duongndph53424@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"


REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${VITE_REVERB_PORT}"
VITE_REVERB_SCHEME="${VITE_REVERB_SCHEME}"
VITE_REVERB_ENABLED=true

# SePay Configuration
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_CHECKOUT_URL=https://qr.sepay.vn/img
SEPAY_QR_TEMPLATE=compact
# SePay bank reconciliation (API v2 / webhook)
SEPAY_API_VERSION=v2
SEPAY_API_BASE_URL=https://userapi.sepay.vn/v2
SEPAY_API_TOKEN=
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_API_KEY=
SEPAY_RESTAURANT_ID=

# Cổng thanh toán online cho khách đặt hàng qua storefront (để trống = ẩn khỏi
# danh sách gateway, chỉ còn bank_transfer/VietQR khả dụng). Driver đã code sẵn
# đầy đủ logic theo tài liệu chính thức từng cổng — chỉ cần điền key thật là chạy được.
VNPAY_TMNCODE=
VNPAY_HASHSECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create

BILLING_WEBHOOK_SECRET=
BILLING_WEBHOOK_PROVIDER=sepay

# Hồi sinh dần các tác vụ định kỳ từng "chết" trong app/Console/Kernel.php (xem
# docs/setup/SCHEDULER_RESTORE.md để biết thứ tự bật an toàn). Mặc định TẮT hết —
# vài tác vụ mutate dữ liệu hoặc gửi email cho khách hàng thật, không bật đồng loạt.
# SCHEDULER_RESTORE_TICKETS_SLA=true
# SCHEDULER_RESTORE_KITCHEN_ALERT_OVERDUE=true
# SCHEDULER_RESTORE_RESERVATIONS_NO_SHOWS=true
# SCHEDULER_RESTORE_RESERVATIONS_REMINDERS=true
# SCHEDULER_RESTORE_PROMOTIONS_EXPIRE=true
# SCHEDULER_RESTORE_SHIFTS_AUTO_CLOSE=true
# SCHEDULER_RESTORE_RESTAURANTS_VALIDATE=true
# SCHEDULER_RESTORE_RESTAURANTS_HEALTH=true
# SCHEDULER_RESTORE_ONBOARDING_SYNC=true
# SCHEDULER_RESTORE_TRIAL_ONBOARDING_EMAILS=true

# Email Microservice (Python FastAPI - port 8001)
EMAIL_SERVICE_URL=http://127.0.0.1:8001

# Chatbot Microservice (Python FastAPI - port 8002)
CHATBOT_SERVICE_URL=http://127.0.0.1:8002

# Analytics Microservice (Python FastAPI - port 8003 local / Vercel production)
ANALYTICS_SERVICE_URL=http://127.0.0.1:8003

# Khóa bí mật nội bộ để Laravel gọi Python microservices.
INTERNAL_API_KEY=

BREVO_API_KEY=

# Dự báo thời tiết thật cho gợi ý thực đơn (OpenWeatherMap free tier, không cần thẻ tín dụng).
# Để trống = dùng fallback ước tính theo lịch sử bán hàng thay vì gọi API.
OPENWEATHER_API_KEY=
OPENWEATHER_URL=https://api.openweathermap.org/data/2.5/forecast

# Laravel Scout & Meilisearch Configuration
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
SCOUT_QUEUE=true

# Security WAF & Global Rate Limiting
WAF_LOGIN_MAX_ATTEMPTS=5
WAF_LOGIN_DECAY_SECONDS=10
WAF_LOGIN_BLOCK_MINUTES=30
RATE_LIMIT_GLOBAL_MAX=60
RATE_LIMIT_GLOBAL_DECAY=60

# Data lifecycle / capacity management
DATA_LIFECYCLE_ENABLED=true
DATA_LIFECYCLE_REQUIRE_APPROVAL=true
DATA_LIFECYCLE_ALLOW_DIRECT_CLI_PURGE=false
DATA_ORDERS_ARCHIVE_MONTHS=3
DATA_ORDERS_PURGE_MONTHS=36
DATA_AUDIT_ARCHIVE_MONTHS=6
DATA_STORAGE_SNAPSHOT_RETENTION_DAYS=730
DATA_MEDIA_ORPHAN_GRACE_DAYS=30
DATA_MEDIA_ORPHAN_BATCH_SIZE=500
DATA_DATABASE_LIMIT_GB=
DATA_TENANT_DATABASE_LIMIT_MB=
SCHEDULER_HEARTBEAT_MAX_MINUTES=10
BACKUP_DISK=local
ARCHIVE_DISK=local
MEDIA_DISK=local
BACKUP_DAILY_RETENTION_DAYS=7
BACKUP_WEEKLY_RETENTION_WEEKS=8
BACKUP_MONTHLY_RETENTION_MONTHS=12
DATA_TEMPORARY_RETENTION_HOURS=24
