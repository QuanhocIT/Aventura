APP_NAME=Aventura
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=5

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aventura
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2526
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="duongndph53424@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"


REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_RATE_LIMITING_ENABLED=true
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=100
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60
REVERB_APP_MAX_CONNECTIONS=1000

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${VITE_REVERB_PORT}"
VITE_REVERB_SCHEME="${VITE_REVERB_SCHEME}"

# SePay Configuration
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_CHECKOUT_URL=https://qr.sepay.vn/img
SEPAY_QR_TEMPLATE=compact

BILLING_WEBHOOK_SECRET=
BILLING_WEBHOOK_PROVIDER=sepay

# Email Microservice (Python FastAPI - port 8001)
EMAIL_SERVICE_URL=http://localhost:8001

# Chatbot Microservice (Python FastAPI - port 8002)
CHATBOT_SERVICE_URL=http://localhost:8002

# Analytics Microservice (Python FastAPI - port 8003)
ANALYTICS_SERVICE_URL=http://localhost:8003

# Shared secret required in the X-Internal-Key header between Laravel and the
# Python microservices — generate with: php -r "echo bin2hex(random_bytes(32));"
MICROSERVICE_INTERNAL_KEY=

BREVO_API_KEY=

# Laravel Scout & Meilisearch Configuration
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
SCOUT_QUEUE=true

# OpenWeather (weather-based demand forecasting) — get a free-tier key at openweathermap.org
OPENWEATHER_API_KEY=
OPENWEATHER_URL=https://api.openweathermap.org/data/2.5/forecast

# Payment gateways — sandbox credentials needed to test end-to-end (see provider dashboards)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

VNPAY_TMNCODE=
VNPAY_HASHSECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=

ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create

# OSRM self-hosted routing server (see docs/setup/osrm-setup.md for provisioning).
# Leave empty until a real OSRM instance is running — OsrmClient falls back to the
# haversine heuristic cleanly when this is blank, so an unset value is safe.
OSRM_URL=