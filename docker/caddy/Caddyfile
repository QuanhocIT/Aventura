your-domain.com {
    # ──────────────────────────────────────────────────────────────
    # Laravel App — HTTP + WebSocket
    # ──────────────────────────────────────────────────────────────

    # WebSocket cho Laravel Reverb (wss://)
    @websocket {
        header Connection *Upgrade*
        header Upgrade    websocket
        path /app/*
    }
    handle @websocket {
        reverse_proxy app:8080
    }

    # Tất cả request khác → PHP-FPM qua Nginx bên trong container app
    handle {
        reverse_proxy app:80
    }

    # Gzip compression
    encode gzip

    # Log ra stdout để docker compose logs bắt được
    log {
        output stdout
        format console
    }
}
